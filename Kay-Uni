-- Services
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Hapus UI lama
if playerGui:FindFirstChild("SimpleRubyHub") then
	playerGui.SimpleRubyHub:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SimpleRubyHub"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- Tombol Utama
local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 160, 0, 45)
btn.Position = UDim2.new(0, 20, 0.2, 0)
btn.BackgroundColor3 = Color3.fromRGB(150, 15, 35)
btn.Text = "💎 RUBY HUB"
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.TextSize = 14
btn.Font = Enum.Font.GothamBold
btn.Draggable = true
btn.Active = true
btn.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = btn

-- Indikator Status
local status = false
btn.MouseButton1Click:Connect(function()
	status = not status
	if status then
		btn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
		btn.Text = "💎 [ aktif ]"
		
		-- Contoh Aksi: Fullbright otomatis
		game.Lighting.Brightness = 3
		game.Lighting.ClockTime = 14
	else
		btn.BackgroundColor3 = Color3.fromRGB(150, 15, 35)
		btn.Text = "💎 RUBY HUB"
		
		game.Lighting.Brightness = 1
		game.Lighting.ClockTime = 0
	end
end)
