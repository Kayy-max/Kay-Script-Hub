local function FetchPublicServers()
    for _, c in pairs(ServerListContainer:GetChildren()) do if c:IsA("Frame") or c:IsA("TextButton") then c:Destroy() end end
    StatusFetchLabel.Text = "Mengambil data server..."
    
    task.spawn(function()
        local success, result = pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=" .. currentSortMode .. "&limit=100"
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        for _, c in pairs(ServerListContainer:GetChildren()) do if c == StatusFetchLabel then c:Destroy() end end
        
        if success and result and result.data then
            local count = 0
            for _, srv in pairs(result.data) do
                if srv.id ~= game.JobId then
                    local isFull = srv.playing >= srv.maxPlayers
                    if showFullServers or not isFull then
                        count = count + 1
                        local card = Instance.new("Frame", ServerListContainer)
                        card.Size = UDim2.new(1, -4, 0, 32)
                        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)
                        table.insert(AllUIElements, {Obj = card, Prop = "BackgroundColor3", Key = "FrameColor"})
                        
                        local infoLbl = Instance.new("TextLabel", card)
                        infoLbl.Size, infoLbl.BackgroundTransparency, infoLbl.Text, infoLbl.Font, infoLbl.TextSize, infoLbl.TextXAlignment = UDim2.new(0.65, 0, 1, 0), UDim2.new(0, 8, 0, 0), string.format("👥 %d/%d Players", srv.playing, srv.maxPlayers), Enum.Font.Gotham, 11, Enum.TextXAlignment.Left
                        table.insert(AllUIElements, {Obj = infoLbl, Prop = "TextColor3", Key = "TextColor"})
                        
                        local joinB = Instance.new("TextButton", card)
                        joinB.Size, joinB.Position, joinB.Text, joinB.Font, joinB.TextSize, joinB.TextColor3 = UDim2.new(0.3, 0, 0.75, 0), UDim2.new(0.68, 0, 0.125, 0), "JOIN", Enum.Font.GothamBold, 10, Color3.fromRGB(255,255,255)
                        joinB.BackgroundColor3 = Color3.fromRGB(20, 140, 80)
                        Instance.new("UICorner", joinB).CornerRadius = UDim.new(0, 4)
                        
                        joinB.MouseButton1Click:Connect(function()
                            if ConfirmOverlay.Visible then return end
                            joinB.Text = "Connecting..."
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, LocalPlayer)
                        end)
                    end
                end
            end
            if count == 0 then
                local emptyLbl = Instance.new("TextLabel", ServerListContainer)
                emptyLbl.Size, emptyLbl.BackgroundTransparency, emptyLbl.Text, emptyLbl.Font, emptyLbl.TextSize = UDim2.new(1, 0, 1, 0), 1, "Tidak ada server yang sesuai.", Enum.Font.Gotham, 11
                table.insert(AllUIElements, {Obj = emptyLbl, Prop = "TextColor3", Key = "MutedText"})
            end
        else
            local errLbl = Instance.new("TextLabel", ServerListContainer)
            errLbl.Size, errLbl.BackgroundTransparency, errLbl.Text, errLbl.Font, errLbl.TextSize = UDim2.new(1, 0, 1, 0), 1, "Gagal mengambil daftar server.", Enum.Font.Gotham, 11
            table.insert(AllUIElements, {Obj = errLbl, Prop = "TextColor3", Key = "MutedText"})
        end
    end)
end

local function FetchFriendsServers()
    for _, c in pairs(ServerListContainer:GetChildren()) do if c:IsA("Frame") or c:IsA("TextButton") then c:Destroy() end end
    StatusFetchLabel.Text = "Mencari server teman..."
    
    task.spawn(function()
        local success, result = pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?limit=100"
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        for _, c in pairs(ServerListContainer:GetChildren()) do if c == StatusFetchLabel then c:Destroy() end end
        
        local foundCount = 0
        local friendsList = {}
        pcall(function() friendsList = LocalPlayer:GetFriendsOnline() end)
        
        if success and result and result.data then
            for _, srv in pairs(result.data) do
                for _, friend in pairs(friendsList) do
                    if friend.IsOnline and friend.GameId == game.GameId and friend.LastLocation == srv.id then
                        foundCount = foundCount + 1
                        local card = Instance.new("Frame", ServerListContainer)
                        card.Size = UDim2.new(1, -4, 0, 32)
                        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)
                        table.insert(AllUIElements, {Obj = card, Prop = "BackgroundColor3", Key = "FrameColor"})
                        
                        local infoLbl = Instance.new("TextLabel", card)
                        infoLbl.Size, infoLbl.BackgroundTransparency, infoLbl.Text, infoLbl.Font, infoLbl.TextSize, infoLbl.TextXAlignment = UDim2.new(0.65, 0, 1, 0), UDim2.new(0, 8, 0, 0), friend.UserName .. " (" .. srv.playing .. "p)", Enum.Font.Gotham, 10, Enum.TextXAlignment.Left
                        table.insert(AllUIElements, {Obj = infoLbl, Prop = "TextColor3", Key = "TextColor"})
                        
                        local joinB = Instance.new("TextButton", card)
                        joinB.Size, joinB.Position, joinB.Text, joinB.Font, joinB.TextSize, joinB.TextColor3 = UDim2.new(0.3, 0, 0.75, 0), UDim2.new(0.68, 0, 0.125, 0), "JOIN", Enum.Font.GothamBold, 10, Color3.fromRGB(255,255,255)
                        joinB.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
                        Instance.new("UICorner", joinB).CornerRadius = UDim.new(0, 4)
                        
                        joinB.MouseButton1Click:Connect(function()
                            if ConfirmOverlay.Visible then return end
                            joinB.Text = "Connecting..."
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, LocalPlayer)
                        end)
                    end
                end
            end
        end
        if foundCount == 0 and #ServerListContainer:GetChildren() == 0 then
            local emptyLbl = Instance.new("TextLabel", ServerListContainer)
            emptyLbl.Size, emptyLbl.BackgroundTransparency, emptyLbl.Text, emptyLbl.Font, emptyLbl.TextSize = UDim2.new(1, 0, 1, 0), 1, "Tidak ada teman di server sebelah.", Enum.Font.Gotham, 11
            table.insert(AllUIElements, {Obj = emptyLbl, Prop = "TextColor3", Key = "MutedText"})
        end
    end)
end

